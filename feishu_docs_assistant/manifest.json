{
  "manifest_version": 3,
  "name": "飞书文档 AI 助手",
  "version": "1.0.0",
  "description": "为飞书文档提供对话、概要、精读与思维导图能力",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.feishu.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.feishu.cn/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "飞书文档 AI 助手"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "sidebar.css", "sidebar.js", "prompt.js", "icon16.png"],
      "matches": ["*://*.feishu.cn/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
